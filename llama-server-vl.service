[Unit]
Description=Qwen3-VL-8B-Instruct llama-server (Tailscale OpenAI vision API)
After=network-online.target default.target llama-server.service
Wants=network-online.target
# Do not restart on CUDA ABRT — a dump loop wedges the next cudaSetDevice.
StartLimitIntervalSec=600
StartLimitBurst=1

[Service]
Type=simple
WorkingDirectory=%h/inference
Environment=HOME=%h
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDA_HOME=/usr/local/cuda
Environment=LLAMA_HOST=100.x.y.z
Environment=LLAMA_PORT=8001
Environment=LLAMA_CTX=16384
Environment=WAIT_DS4_TRIES=240
Environment=WAIT_DS4_GPU_MIB=90000
Environment=WAIT_DS4_STABLE_SEC=60
Environment=WAIT_DS4_STABLE_DELTA_MIB=2048
Environment=WAIT_DS4_GPU_TRIES=120
ExecStartPre=/bin/bash -c 'test -x %h/inference/llama.cpp/build/bin/llama-server'
ExecStartPre=/bin/bash -c 'test -f %h/models/Qwen3-VL-8B-Instruct-GGUF/Qwen3-VL-8B-Instruct-Q8_0.gguf'
ExecStartPre=/bin/bash -c 'test -f %h/models/Qwen3-VL-8B-Instruct-GGUF/mmproj-F16.gguf'
ExecStartPre=/bin/bash -c 'test -x %h/inference/wait-ds4-ready.sh'
# HTTP 200 is not enough; wait until the large LLM GPU allocation is high and stable.
ExecStartPre=%h/inference/wait-ds4-ready.sh
ExecStart=%h/inference/llama-server-vl-start.sh
Restart=no
TimeoutStartSec=2400
TimeoutStopSec=60
KillMode=mixed
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server-vl

[Install]
WantedBy=default.target
